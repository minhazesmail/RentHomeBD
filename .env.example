# Required. Copy this file to .env.local and fill in values from your Supabase project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional — enable before high-traffic phone OTP (see docs/phone-otp-production.md).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Optional public, domain-restricted CARTO key for dark map tiles.
# Without this, all themes use the existing OpenStreetMap provider.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
